# ============================================================
# Noceur Finance — Environment Variables
# Salin file ini menjadi .env.local dan isi nilai yang diperlukan.
# JANGAN PERNAH commit .env.local ke git.
# ============================================================

# ------------------------------------------------------------
# [WAJIB] Supabase Credentials
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# [WAJIB UNTUK BOT] Meta WhatsApp Cloud API
# Dapatkan dari Meta for Developers -> WhatsApp -> API Setup
# ------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=noceur_finance_webhook_verify_secret
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ------------------------------------------------------------
# [OPSIONAL] Google Gemini API
# Untuk AI fallback parsing percakapan WhatsApp
# Dapatkan di: https://aistudio.google.com/
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# [OPSIONAL] Cron Jobs & Push Notifications
# ------------------------------------------------------------
CRON_SECRET=your-secure-cron-secret
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
